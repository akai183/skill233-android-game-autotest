{
  "name": "示例游戏 新号首次进入（清数据）",
  "description": "清掉应用数据模拟全新用户，验证：清数据后能否重新拉热更、登录页是否出现、账号能否输入、是否进角色选择页、选完角色能否进主城。必须用**没用过的账号名**才会出现角色选择页（老账号会直接进主城）。 注意：只有从未登录过的账号名才会出现角色选择页；账号名被复用过会直接进主城，这时 expect-role 探测为假、pick-role 自动跳过。 想稳定走角色页分支请用 --var ACCOUNT=<没用过的名字> 换一个新账号名。",
  "vars": {
    "PKG": "com.example.game",
    "ACCOUNT": "demo01",
    "ACTIVITY": "com.unity3d.player.UnityPlayerActivity"
  },
  "device": {
    "stay_awake": true,
    "unlock": true
  },
  "steps": [
    {
      "id": "wake",
      "action": "wake",
      "screenshot": false
    },
    {
      "id": "ime-off",
      "action": "ime",
      "mode": "off",
      "screenshot": false
    },
    {
      "id": "wipe",
      "action": "clear_data",
      "package": "${PKG}",
      "message": "清空应用数据，模拟全新用户"
    },
    {
      "id": "mark",
      "action": "logcat_mark",
      "screenshot": false
    },
    {
      "id": "launch",
      "action": "launch",
      "package": "${PKG}",
      "expect_activity": "${PKG}",
      "timeout": 40,
      "wait": 3.0
    },
    {
      "id": "wait-login",
      "action": "wait_template",
      "template": "templates/login_start_btn.png",
      "timeout": 240,
      "threshold": 0.88,
      "interval": 2.0,
      "message": "等登录页出现（首次要重新下载热更资源，给足 240s）"
    },
    {
      "id": "fill-account",
      "action": "tap",
      "ratio": [
        0.5,
        0.478
      ],
      "message": "点账号输入框"
    },
    {
      "id": "type-account",
      "action": "text",
      "text": "${ACCOUNT}",
      "clear": true,
      "clear_times": 40
    },
    {
      "id": "tap-start",
      "action": "wait_template",
      "template": "templates/login_start_btn.png",
      "timeout": 15,
      "threshold": 0.88,
      "tap": true,
      "message": "点「开始游戏」"
    },
    {
      "id": "expect-role",
      "action": "wait_template",
      "template": "templates/role_title.png",
      "timeout": 25,
      "threshold": 0.85,
      "interval": 1.0,
      "must_find": false,
      "message": "探测是否出现角色选择页（账号名被用过则直接进主城，属正常）",
      "save": "NEED_ROLE"
    },
    {
      "id": "pick-role",
      "action": "wait_template",
      "template": "templates/role_confirm_btn.png",
      "timeout": 20,
      "threshold": 0.9,
      "scale": 1,
      "tap": true,
      "message": "点「确定」选默认角色",
      "when": "NEED_ROLE"
    },
    {
      "id": "wait-maincity",
      "action": "wait_template",
      "template": "templates/maincity_action_btn.png",
      "timeout": 180,
      "threshold": 0.88,
      "interval": 1.0,
      "message": "等主城主要操作按钮出现"
    },
    {
      "id": "check-crash",
      "action": "check_crash",
      "must_clean": true,
      "message": "新号全程不应有崩溃（良性告警已自动剔除）"
    },
    {
      "id": "dump-logcat",
      "action": "dump_logcat",
      "name": "logcat-newuser",
      "screenshot": false
    },
    {
      "id": "final",
      "action": "screenshot",
      "name": "final"
    }
  ]
}