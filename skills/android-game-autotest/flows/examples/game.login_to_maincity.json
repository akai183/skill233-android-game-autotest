{
  "name": "示例游戏 登录到主城",
  "description": "从冷启动开始，走完 登录页 → 输入账号 → 开始游戏 → 角色选择 → 主城 的完整链路。新号走角色选择分支，老号直接进主城（用 when 条件分支）。用途：验证登录链路是否通、是否卡在某个页面、是否有崩溃。",
  "vars": {
    "PKG": "com.example.game",
    "ACCOUNT": "autotest233",
    "ACTIVITY": "com.unity3d.player.UnityPlayerActivity"
  },
  "device": {
    "stay_awake": true,
    "unlock": true
  },
  "steps": [
    {
      "id": "wake",
      "action": "wake",
      "screenshot": false
    },
    {
      "id": "ime-off",
      "action": "ime",
      "mode": "off",
      "screenshot": false,
      "message": "关掉中文输入法，否则 input text 的 ASCII 会被拼音组词污染"
    },
    {
      "id": "restart",
      "action": "force_stop",
      "package": "${PKG}",
      "screenshot": false
    },
    {
      "id": "mark",
      "action": "logcat_mark",
      "screenshot": false
    },
    {
      "id": "launch",
      "action": "launch",
      "package": "${PKG}",
      "expect_activity": "${PKG}",
      "timeout": 40,
      "wait": 3.0
    },
    {
      "id": "wait-login",
      "action": "wait_template",
      "template": "templates/login_start_btn.png",
      "timeout": 120,
      "threshold": 0.88,
      "interval": 1.0,
      "message": "等登录页出现「开始游戏」按钮"
    },
    {
      "id": "fill-account",
      "action": "tap",
      "ratio": [
        0.5,
        0.478
      ],
      "message": "点账号输入框"
    },
    {
      "id": "clear-account",
      "action": "text",
      "text": "${ACCOUNT}",
      "clear": true,
      "clear_times": 40,
      "message": "清空旧账号并输入新账号"
    },
    {
      "id": "tap-start",
      "action": "wait_template",
      "template": "templates/login_start_btn.png",
      "timeout": 15,
      "threshold": 0.88,
      "tap": true,
      "message": "点「开始游戏」"
    },
    {
      "id": "probe-role",
      "action": "probe_template",
      "template": "templates/role_title.png",
      "timeout": 25,
      "threshold": 0.85,
      "save": "NEED_ROLE",
      "message": "判断是否出现角色选择页（新号才会出现）"
    },
    {
      "id": "pick-role",
      "action": "wait_template",
      "template": "templates/role_confirm_btn.png",
      "timeout": 30,
      "threshold": 0.9,
      "scale": 1,
      "tap": true,
      "when": "NEED_ROLE",
      "message": "新号：点「确定」选默认角色"
    },
    {
      "id": "wait-maincity",
      "action": "wait_template",
      "template": "templates/maincity_action_btn.png",
      "timeout": 120,
      "threshold": 0.88,
      "interval": 1.0,
      "message": "等主城主要操作按钮出现"
    },
    {
      "id": "check-crash",
      "action": "check_crash",
      "must_clean": false,
      "message": "扫描登录全程日志（不要求干净，只记录）"
    },
    {
      "id": "dump-logcat",
      "action": "dump_logcat",
      "name": "logcat-login",
      "screenshot": false
    },
    {
      "id": "final",
      "action": "screenshot",
      "name": "final"
    }
  ]
}